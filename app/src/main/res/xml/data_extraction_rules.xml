<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="prizma_settings.xml" />
        <include domain="file" path="prizma/" />
        <exclude domain="sharedpref" path="prizma_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="prizma_settings.xml" />
        <include domain="file" path="prizma/" />
    </device-transfer>
</data-extraction-rules>
