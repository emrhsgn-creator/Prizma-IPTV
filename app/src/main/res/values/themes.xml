<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Prizma" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/prizma_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:colorBackground">@color/prizma_bg</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>

    <style name="Theme.Prizma.Player" parent="Theme.Prizma">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

</resources>
