<?xml version="1.0" encoding="utf-8"?>
<!--
  Televizyonda uzaktan bakildiginda odagin nerede oldugu hemen anlasilsin diye
  yuksek kontrastli vurgu: dolu mavi zemin ve kalin beyaz cerceve.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF2F6FE0" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF1E4FA8" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
        </shape>
    </item>
</selector>
