<?xml version="1.0" encoding="utf-8"?>
<!--
  Odaklanan dugme hafifce buyusun. Dinleyici yerine durum animatoru
  kullaniliyor; boylece media3'un kendi odak dinleyicileri ezilmiyor.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <set>
            <objectAnimator
                android:propertyName="scaleX"
                android:valueTo="1.18"
                android:duration="120" />
            <objectAnimator
                android:propertyName="scaleY"
                android:valueTo="1.18"
                android:duration="120" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator
                android:propertyName="scaleX"
                android:valueTo="1.0"
                android:duration="120" />
            <objectAnimator
                android:propertyName="scaleY"
                android:valueTo="1.0"
                android:duration="120" />
        </set>
    </item>
</selector>
